APP_NAME=ATMOS API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql+psycopg://atmos:atmos_dev_password@localhost:5432/atmos
JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_EMAIL_DOMAINS=udla.edu.ec
FRONTEND_BASE_URL=http://localhost:5173
BACKEND_BASE_URL=http://localhost:8000
EMAIL_PROVIDER=log
ACS_EMAIL_CONNECTION_STRING=
ACS_EMAIL_SENDER_ADDRESS=
EMAIL_FROM_NAME=ATMOS
EMAIL_ATMOS_LOGO_URL=
EMAIL_UDLA_LOGO_URL=
REMMAQ_BASE_URL=https://datosambiente.quito.gob.ec/
# Optional: if this instance's IP cannot reach REMMAQ_BASE_URL directly, point
# this at a tunnel (e.g. ngrok) to scripts/remmaq_proxy.py running on a
# machine that can. Leave empty for direct access. See README.md.
REMMAQ_PROXY_BASE_URL=
ETL_STORAGE_DIR=./data/etl
WORKSPACE_STORAGE_DIR=./data/workspaces
ETL_REQUEST_TIMEOUT_SECONDS=60
ETL_DISCOVERY_MAX_PAGES=20
ETL_USER_AGENT=ATMOS-ETL/1.0 (+https://udla.edu.ec)
ETL_ROW_CHUNK_SIZE=2000
ETL_LOOKUP_CHUNK_SIZE=500
ETL_SYNC_DEFAULT_MAX_ARCHIVES=4
AUTO_INIT_DB_ON_STARTUP=true
