# Shared local variables (optional)
COMPOSE_PROJECT_NAME=atmos

# Backend auth/session defaults
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_EMAIL_DOMAINS=udla.edu.ec
FRONTEND_BASE_URL=http://localhost:5173
BACKEND_BASE_URL=http://localhost:8000
EMAIL_PROVIDER=log
ACS_EMAIL_CONNECTION_STRING=endpoint=https://atmos-auth.unitedstates.communication.azure.com
ACS_EMAIL_SENDER_ADDRESS=DoNotReply@<hash>.azurecomm.net
EMAIL_FROM_NAME=ATMOS
AUTO_INIT_DB_ON_STARTUP=true
